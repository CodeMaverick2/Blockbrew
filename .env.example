# BlockBrew Environment Configuration
# Copy this file to .env.local and fill in your values

# ============================================
# API Keys (Optional - for enhanced access)
# ============================================

# Etherscan API V2 Key (https://etherscan.io/apis)
# Required for: BSC (no free alternative since Dec 2025)
# Enhances: All EVM chains as fallback
NEXT_PUBLIC_ETHERSCAN_API_KEY=

# Subscan API Key (https://support.subscan.io/)
# Enhances: Polkadot, Bittensor (higher rate limits)
NEXT_PUBLIC_SUBSCAN_API_KEY=

# ============================================
# Chain Support Status (as of 2025)
# ============================================
#
# FREE (No API key needed):
# ✓ Ethereum    - Blockscout, Routescan
# ✓ Polygon     - Blockscout, Routescan
# ✓ Arbitrum    - Blockscout, Routescan
# ✓ Optimism    - Blockscout, Routescan
# ✓ Base        - Blockscout, Routescan
# ✓ Avalanche   - Routescan
# ✓ Solana      - Official RPC
# ✓ Bitcoin     - Mempool.space, Blockchair
# ✓ Polkadot    - Subscan (free tier)
# ✓ Cosmos      - Public LCD endpoints
# ✓ Osmosis     - Public LCD endpoints
# ✓ Ronin       - Official explorer (may be rate limited)
#
# REQUIRES API KEY:
# ⚠ BSC         - Etherscan V2 key required (BSCScan deprecated free tier)
# ⚠ Bittensor   - Limited without Subscan key
#
# API Sources:
# - Blockscout: https://docs.blockscout.com (free, open-source)
# - Routescan: https://routescan.io (free tier: 2 RPS, 10K daily)
# - Mempool.space: https://mempool.space/docs/api (free)
# - Subscan: https://subscan.io (free tier available)
