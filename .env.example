# BlockBrew Environment Configuration
# Copy this file to .env.local and fill in your values

# Optional: API Keys for enhanced rate limits
# Get your free API keys from these explorers:

# Etherscan API Key (https://etherscan.io/apis)
# ETHERSCAN_API_KEY=

# Polygonscan API Key (https://polygonscan.com/apis)
# POLYGONSCAN_API_KEY=

# BSCScan API Key (https://bscscan.com/apis)
# BSCSCAN_API_KEY=

# Arbiscan API Key (https://arbiscan.io/apis)
# ARBISCAN_API_KEY=

# Optimism Etherscan API Key (https://optimistic.etherscan.io/apis)
# OPTIMISM_API_KEY=

# BaseScan API Key (https://basescan.org/apis)
# BASESCAN_API_KEY=

# Snowtrace API Key (https://snowtrace.io/apis)
# SNOWTRACE_API_KEY=

# Subscan API Key (https://support.subscan.io/)
# SUBSCAN_API_KEY=

# Note: The app works without API keys using public endpoints,
# but you may experience rate limiting with heavy usage.
